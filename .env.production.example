# ==============================================================================
# ARAM Production Cloud Environment Template
# ==============================================================================
# Use these environment variables when setting up:
# 1. Frontend: Vercel Project Settings -> Environment Variables
# 2. Backend: Render / Railway / AWS / Docker Environment Variables
# 3. AI Service: Render / Railway / AWS / Docker Environment Variables
# ==============================================================================

# ==========================================
# A. VERCEL FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# (Configure in Vercel Dashboard -> Settings -> Environment Variables)
# Target: Production, Preview, Development
VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_AUTH_SERVICE_BASE_URL=https://api.yourdomain.com/api
VITE_AI_SERVICE_BASE_URL=https://ai.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com
VITE_USE_MOCKS=false

# ==========================================
# B. SPRING BOOT BACKEND ENVIRONMENT VARIABLES
# ==========================================
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=mysql

# MySQL Managed Database
DB_HOST=your-mysql-host.rds.amazonaws.com
DB_PORT=3306
DB_NAME=aram_db
DB_USERNAME=aram_admin
DB_PASSWORD=YourStrongDatabasePassword123!
# Or unified connection string:
DB_URL=jdbc:mysql://your-mysql-host.rds.amazonaws.com:3306/aram_db?useSSL=true&requireSSL=false&serverTimezone=Asia/Kolkata

# Redis Managed Cache & PubSub
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YourStrongRedisPassword123!

# MongoDB Atlas Document Store
MONGO_URI=mongodb+srv://aram_admin:YourMongoPassword@cluster0.mongodb.net/aram_logs?retryWrites=true&w=majority
MONGO_DB=aram_logs

# Microservice & JWT Security
JWT_SECRET=Your64CharacterCryptographicallySecureKeyAtLeast64BytesLongHere!
INTERNAL_API_TOKEN=Your32CharacterInternalMicroserviceSharedTokenHere!
AI_INTERNAL_TOKEN=Your32CharacterInternalMicroserviceSharedTokenHere!
APP_ENCRYPTION_KEY=ARAMLegalAidEncryptionSecretKey2026

# Allowed Frontend Origins & Host Binding (Strict CORS)
APP_FRONTEND_URL=https://your-app.vercel.app
APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com

# Service Inter-Communication
AI_SERVICE_URL=https://ai.yourdomain.com

# Optional SMTP Configuration
SPRING_MAIL_USERNAME=notifications@yourdomain.com
SPRING_MAIL_PASSWORD=your-google-app-password
APP_MAIL_ENABLED=true

# ==========================================
# C. FASTAPI AI SERVICE ENVIRONMENT VARIABLES
# ==========================================
PORT=8000
ENVIRONMENT=production
INTERNAL_API_TOKEN=Your32CharacterInternalMicroserviceSharedTokenHere!
MONGO_URI=mongodb+srv://aram_admin:YourMongoPassword@cluster0.mongodb.net/aram_logs?retryWrites=true&w=majority
MONGODB_DATABASE=aram_logs
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YourStrongRedisPassword123!

# External LLM & Speech API Keys
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
GEMINI_MODEL=gemini-1.5-flash
DEEPGRAM_API_KEY=your-deepgram-api-key
STT_ENGINE=deepgram
