# ==============================================================================
# ARAM Production Environment Configuration
# Copy this file to .env on your production server and fill in real values.
# ==============================================================================

# Database Credentials
DB_NAME=aram_db
DB_USERNAME=aram_user
DB_PASSWORD=ChangeThisToAStrongProductionPassword2026!
DB_ROOT_PASSWORD=ChangeThisToAStrongRootPassword2026!

# Redis Cache
REDIS_PASSWORD=ChangeThisToAStrongRedisPassword2026!

# MongoDB AI Logs
MONGO_DB=aram_logs

# JWT Authentication
JWT_SECRET=Your64CharacterOrLongerCryptographicallySecureSecretKeyHere2026!
AI_INTERNAL_TOKEN=YourInternalMicroserviceSecretToken2026!

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-organization-email@gmail.com
SMTP_PASSWORD=your-google-app-password

# AI & External APIs
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
DEEPGRAM_API_KEY=your-deepgram-api-key

# Client Application URLs
VITE_API_BASE_URL=/api
VITE_AUTH_SERVICE_BASE_URL=/api
VITE_AI_SERVICE_BASE_URL=/ai-api
VITE_USE_MOCKS=false
