# ==============================================================================
# ARAM Legal Aid Platform — Environment Template
# Copy this file to .env or run: python scripts/generate_env.py
# NEVER commit your real .env file with secrets to version control.
# ==============================================================================

# Database Credentials
DB_NAME=aram_db
DB_USERNAME=aram
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/aram_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB AI Logs
MONGO_URI=mongodb://localhost:27017/aram_logs
MONGO_DB=aram_logs

# Authentication & Microservice Security
# JWT_SECRET must be at least 32 characters (use scripts/generate_env.py to generate)
JWT_SECRET=
INTERNAL_API_TOKEN=
AI_INTERNAL_TOKEN=

# Email Service (Optional)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_ENABLED=false

# External AI APIs (Optional / Cloud Fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DEEPGRAM_API_KEY=

# Service Endpoints
AI_SERVICE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:8082/api
VITE_AUTH_SERVICE_BASE_URL=http://localhost:8082/api
VITE_AI_SERVICE_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=false
