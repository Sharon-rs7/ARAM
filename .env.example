# ==============================================================================
# ARAM Legal Aid Platform — Master Environment Template
# ==============================================================================
# Copy this file to .env for local development.
# For production deployments (Vercel, Render, Railway, AWS), configure these in
# the respective cloud provider's dashboard settings.
# NEVER commit files containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL Relational Database (Spring Boot Backend)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aram_db
DB_USERNAME=aram
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password
# Full JDBC URL (used as default or composite fallback)
DB_URL=jdbc:mysql://localhost:3306/aram_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Redis In-Memory Cache, Pub/Sub & Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MongoDB Document Store (AI Query Logs & Telemetry)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/aram_logs
MONGO_DB=aram_logs

# ------------------------------------------------------------------------------
# 4. Authentication, Encryption & Internal Microservice Security
# ------------------------------------------------------------------------------
# JWT_SECRET: Must be a cryptographically random string of 32+ characters (64+ recommended)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_min
# Shared secret token for Spring Boot <-> FastAPI server-to-server calls
INTERNAL_API_TOKEN=internal_microservice_token_min_32_characters_secure
AI_INTERNAL_TOKEN=internal_microservice_token_min_32_characters_secure
# 256-bit AES-GCM Key for encrypting citizen sensitive PII fields in database
APP_ENCRYPTION_KEY=ARAMLegalAidEncryptionSecretKey2026

# ------------------------------------------------------------------------------
# 5. Core Backend Operational Settings & CORS
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
# In production, set to your actual Vercel domain: e.g. https://aram-legal-aid.vercel.app
APP_FRONTEND_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
AI_SERVICE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 6. Email Service (Optional — SMTP Gmail TLS)
# ------------------------------------------------------------------------------
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_ENABLED=false

# ------------------------------------------------------------------------------
# 7. AI Microservice External API Keys (Optional Fallbacks)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# 8. Frontend Public Configuration (Vercel Client Bundle)
# NOTE: Only variables starting with VITE_ are exposed to the browser.
# DO NOT place database passwords, JWT secrets, or cloud API keys in VITE_* vars.
# ------------------------------------------------------------------------------
# In production: https://<your-backend-api-domain>/api
VITE_API_BASE_URL=http://localhost:8082/api
VITE_AUTH_SERVICE_BASE_URL=http://localhost:8082/api
# In production: https://<your-ai-service-domain>
VITE_AI_SERVICE_BASE_URL=http://localhost:8000
# In production: wss://<your-backend-api-domain>
VITE_WS_URL=ws://localhost:8082
VITE_USE_MOCKS=false
