# ==============================================================================
# ARAM Spring Boot Core Backend - Production Environment Configuration
# ==============================================================================

# 1. Spring Active Profiles
# Set to 'prod,mysql' for production deployment
SPRING_PROFILES_ACTIVE=prod,mysql

# 2. Server & Cloud Port Binding
# Set automatically by cloud platforms (Render, Railway, Fly.io) via PORT, or customize via SERVER_PORT
PORT=8082
SERVER_PORT=8082

# 3. Production MySQL Database (Required)
# Configure via either full DB_URL or individual components
DB_HOST=your-production-db-host.com
DB_PORT=3306
DB_NAME=aram_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_USE_SSL=true

# Optional complete connection string override (e.g. AWS RDS, PlanetScale, Railway)
# DB_URL=jdbc:mysql://your-production-db-host.com:3306/aram_db?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata

# 4. JWT & Authentication Secrets (Required - minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_256_bit_jwt_secret_32_chars_min

# 5. Field-Level PII AES-256 Encryption Key (Required - minimum 16 characters)
APP_ENCRYPTION_KEY=replace_with_a_secure_aes_256_key_32_chars_recommended

# 6. Internal AI Service Authentication Token (Required - minimum 16 characters)
INTERNAL_API_TOKEN=replace_with_shared_internal_ai_token_32_chars_min

# 7. AI Microservice URL (FastAPI Service)
AI_SERVICE_URL=http://your-ai-service-host:8000

# 8. CORS & Allowed Frontend Origins (Required)
APP_CORS_ALLOWED_ORIGINS=https://aram-lyart.vercel.app
APP_FRONTEND_URL=https://aram-lyart.vercel.app

# 9. Persistent File Upload Storage Directory
APP_UPLOAD_DIR=/app/uploads

# 10. Bootstrap Super Admin Account (Optional on first deployment)
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=your_initial_superadmin_secure_password

# 11. Optional Services (Explicitly disabled initially)
SPRING_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AI_LOGS_MONGODB_ENABLED=false
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/aram_logs

APP_MAIL_ENABLED=false
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

APP_SEED_ENABLED=false
